    if not os.path.isfile(model):
        return E_NOTHING
    for g in guards:
        lo, hi = g.get("range", [0, 0])
        if not (lo < hi):
            print(f"guards: `{g['name']}` has range [{lo}, {hi}], which brackets "
                  f"nothing", file=sys.stderr)
            return E_BAD_RANGE