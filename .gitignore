# Rust
/target/
**/*.rs.bk
# the provider pin's local environment (uv); uv.lock IS committed
/provider/.venv/
# reaper state and caches live outside the tree, but a stray local one should not land
/.reaper/
# editor / OS
*.swp
.DS_Store
# secrets never sit in a tree: curlrc, age identities, tokens
*.curlrc
*.age
age-identity*

# OrcaSlicer writes result.json into the CURRENT directory, so running
# `orca-slicer --info` from a fixture directory drops one there. It was swept
# into a commit by `git add -A` on 2026-11-16 and removed in the next one.
# Ignored rather than remembered.
result.json

# a mutation in flight, written by tools/mutate.sh; never committed
.mutation-in-flight

# Python bytecode. COMMITTED ONCE, 2026-11-19 (rook F14): a broad `git add -A`
# that fixed an untracked module also took tools/__pycache__/*.pyc with it, so
# every box with a different Python dirtied the tree on its first run and a
# "tree clean" check after a mutant sweep read noise. The tools also set
# sys.dont_write_bytecode before importing a sibling, so none is written at
# all -- a stale .pyc executing instead of source has cost me a day before.
__pycache__/
*.pyc
